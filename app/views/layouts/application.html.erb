<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Datahound" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Datahound">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="color-(--base-text) bg-(--background)">
    <header class="border-b border-(--divider-color) bg-(--bg-disabled)">
      <nav class="container mx-auto max-w-5xl flex items-center justify-between px-5 py-4">
        <a href="<%= root_path %>" class="text-lg font-semibold no-underline color-(--base-text)">Datahound</a>
        <div class="flex items-center gap-4">
          <%= link_to "Quotes", quotes_path, class: "text-sm no-underline color-(--base-text-secondary)" %>
          <%= link_to "Customers", customers_path, class: "text-sm no-underline color-(--base-text-secondary)" %>
          <% if Rails.env.local? %>
            <%= link_to "Docs", docs_root_path, class: "text-sm no-underline color-(--text-primary)" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto max-w-5xl px-5 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="border-t border-(--divider-color) color-(--text-muted) bg-(--bg-disabled)">
      <div class="container mx-auto max-w-5xl px-5 py-6 text-sm">
        Datahound
      </div>
    </footer>
  </body>
</html>
