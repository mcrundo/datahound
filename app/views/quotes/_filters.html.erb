<%= form_with url: quotes_path, method: :get, id: "filter-form", data: { turbo_frame: "quotes_table", turbo_action: "advance" } do |f| %>
  <div class="flex flex-wrap items-end gap-4">
    <div class="form-group mb-0">
      <label for="region">State</label>
      <select name="region" id="region" onchange="this.form.requestSubmit()">
        <option value="">All States</option>
        <% Region.order(:abbreviation).pluck(:abbreviation).each do |abbr| %>
          <option value="<%= abbr %>" <%= "selected" if params[:region] == abbr %>><%= abbr %></option>
        <% end %>
      </select>
    </div>

    <div class="form-group mb-0">
      <label for="supplier_id">Supplier</label>
      <select name="supplier_id" id="supplier_id" onchange="this.form.requestSubmit()">
        <option value="">All Suppliers</option>
        <% Supplier.order(:name).each do |supplier| %>
          <option value="<%= supplier.id %>" <%= "selected" if params[:supplier_id] == supplier.id.to_s %>><%= supplier.name %></option>
        <% end %>
      </select>
    </div>

    <div class="form-group mb-0">
      <label for="tax_included">Tax Included</label>
      <select name="tax_included" id="tax_included" onchange="this.form.requestSubmit()">
        <option value="">All</option>
        <option value="true" <%= "selected" if params[:tax_included] == "true" %>>Yes</option>
        <option value="false" <%= "selected" if params[:tax_included] == "false" %>>No</option>
      </select>
    </div>

    <div class="form-group mb-0">
      <label for="sort">Sort By</label>
      <select name="sort" id="sort" onchange="this.form.requestSubmit()">
        <option value="">Newest</option>
        <option value="rate_asc" <%= "selected" if params[:sort] == "rate_asc" %>>Rate (low to high)</option>
        <option value="rate_desc" <%= "selected" if params[:sort] == "rate_desc" %>>Rate (high to low)</option>
        <option value="normalized_rate_asc" <%= "selected" if params[:sort] == "normalized_rate_asc" %>>Normalized Rate (low to high)</option>
        <option value="normalized_rate_desc" <%= "selected" if params[:sort] == "normalized_rate_desc" %>>Normalized Rate (high to low)</option>
        <option value="customer_asc" <%= "selected" if params[:sort] == "customer_asc" %>>Customer (A-Z)</option>
        <option value="customer_desc" <%= "selected" if params[:sort] == "customer_desc" %>>Customer (Z-A)</option>
        <option value="supplier_asc" <%= "selected" if params[:sort] == "supplier_asc" %>>Supplier (A-Z)</option>
        <option value="supplier_desc" <%= "selected" if params[:sort] == "supplier_desc" %>>Supplier (Z-A)</option>
      </select>
    </div>

    <% if params[:region].present? || params[:supplier_id].present? || params[:tax_included].present? || params[:sort].present? %>
      <%= link_to "Clear", quotes_path, class: "btn btn-sm btn-link", data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %>
