<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1>Quotes</h1>
    <%= link_to "Import CSV", new_import_path, class: "btn btn-primary" %>
  </div>

  <% if @import %>
    <%= turbo_stream_from @import %>
    <%= render "imports/status", import: @import, status: @import.status, rows_processed: 0, error_count: 0 %>
  <% end %>

  <%= render "quotes/list", quotes: @quotes %>
</div>
