<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1>Customer Summary</h1>
    <%= link_to "All Quotes", quotes_path, class: "btn btn-outline" %>
  </div>

  <% if @customers.any? %>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <% @customers.each do |customer| %>
        <% best_quote = @best_quotes[customer.id] %>
        <div class="card space-y-3">
          <div class="flex items-start justify-between">
            <div>
              <h3 class="text-lg font-semibold"><%= customer.name %></h3>
              <p class="text-sm text-muted"><%= customer.region.abbreviation %> — <%= number_with_precision(customer.region.tax_rate, precision: 2) %>% tax rate</p>
            </div>
            <span class="text-sm text-muted"><%= customer.quotes_count %> <%= "quote".pluralize(customer.quotes_count) %></span>
          </div>

          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="text-xs text-muted">Best Rate</p>
              <p class="text-lg font-semibold color-(--text-success)"><%= number_with_precision(customer.best_rate, precision: 4) %></p>
            </div>
            <div>
              <p class="text-xs text-muted">Avg Rate</p>
              <p class="text-lg font-semibold"><%= number_with_precision(customer.avg_rate, precision: 4) %></p>
            </div>
            <div>
              <p class="text-xs text-muted">Spread</p>
              <p class="text-lg font-semibold"><%= number_with_precision(customer.rate_spread, precision: 4) %></p>
            </div>
          </div>

          <% if best_quote %>
            <div class="rounded-md bg-(--bg-success-secondary) color-(--text-on-success-secondary) px-3 py-2 text-sm">
              Best: <strong><%= best_quote.supplier.name %></strong> at <%= number_with_precision(best_quote.normalized_rate, precision: 4) %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card text-center">
      <p class="text-(--base-text-tertiary)">No customers yet.</p>
      <p><%= link_to "Import quotes to get started", new_import_path, class: "link" %></p>
    </div>
  <% end %>
</div>
